{
  "name": "sot-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Sea of Thieves stats tracker — static front-end + local API for Steam/Xbox public data",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "site": "node server/static.js",
    "build:ext": "node tools/build-extension.js",
    "build:logo": "node tools/make-store-logo.js extension/store/logo-300.png",
    "test:alarm": "node tools/test-alarm.js",
    "build:og": "node tools/make-og-image.js assets/img/og-card.png"
  },
  "engines": {
    "node": ">=20.12"
  },
  "author": "Vyros__",
  "homepage": "https://sottracker.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elock-exe/SeaOfThieves-Trackers"
  }
}
