# Copy this file to `.env` and paste your keys in.
# `.env` is git-ignored — your keys never leave your machine.

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# https://xbl.io  (sign in with a Microsoft account)
OPENXBL_API_KEY=

# ---------------------------------------------------------------
# Link YOUR Sea of Thieves account (optional).
# This unlocks gold, Hourglass rank, reputation and commendations —
# data Rare only serves to the signed-in account.
#
# How to get it:
#   1. Sign in at https://www.seaofthieves.com
#   2. Press F12 → Application (or Storage) → Cookies → seaofthieves.com
#   3. Copy the VALUE of the cookie named `rat`
#
# This is a session token: anyone holding it can act as you on the
# Sea of Thieves website. It stays in this file, which is git-ignored,
# and is never sent to the browser. It expires after a few days/weeks —
# when the site says the session expired, repeat the steps above.
# ---------------------------------------------------------------
SOT_RAT_COOKIE=

# port the local API listens on
PORT=8787

# ---------------------------------------------------------------
# DEPLOYMENT (only needed when the tracker runs on a real host)
# ---------------------------------------------------------------

# Where the site is served from, so the API accepts its requests.
# Comma-separated, no trailing slash. localhost is always allowed.
#   SITE_ORIGIN=https://sot-tracker.netlify.app,https://www.mytracker.gg
SITE_ORIGIN=

# PORT is already set above. Most hosts inject their own value and it
# takes precedence, so leave it as-is when deploying.

# Port for the static site in local development (npm run site).
SITE_PORT=

# ---------------------------------------------------------------
# PERSISTENT STORAGE (required when deployed on a free host)
#
# Without these, the API stores everything in data/ on local disk —
# which free hosts erase on every restart, taking all accounts and
# stats with it. See docs/DEPLOY.md step 2b and docs/database.sql.
#
# The service_role key bypasses row-level security: it belongs on the
# server only, never in assets/js/config.js or any file the browser
# can read.
# ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
