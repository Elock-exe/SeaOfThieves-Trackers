{
  "manifest_version": 3,
  "name": "Sea of Thieves Tracker",
  "version": "0.2.0",
  "description": "Sync your Sea of Thieves gold, Hourglass rank and reputation to your tracker. Your session never leaves this browser.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.seaofthieves.com/*",
    "https://sot-tracker-api-ssi7.onrender.com/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.seaofthieves.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sea of Thieves Tracker",
    "default_popup": "src/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "//host_permissions": "Exactly what a sync touches: the game site to read stats, the tracker to publish them, localhost for development. Self-hosting a tracker elsewhere means adding that origin here."
}
